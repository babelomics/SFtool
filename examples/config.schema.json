{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SFtool config schema",
  "type": "object",

  "required": ["paths", "resources","references", "genebe_credentials", "smaca_thresholds"],

  "properties": {
    "version": { "type": "string" },

    "paths": {
      "type": "object",
      "required": ["categories", "bcftools", "htslib", "genebe", "java", "python", "pharmCAT"],
      "properties": {
        "categories": { "type": "string" },
        "bcftools": { "type": "string" },
        "bgzip": { "type": "string" },
        "genebe": { "type": "string" },
        "java": { "type": "string" },
        "python": { "type": "string" },
        "pharmCAT": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "genomes": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "GRCh37": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "GRCh38": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      }
    },

    "genebe_credentials": {
      "type": "object",
      "required": ["api_key", "username"],
      "properties": {
        "api_key": { "type": "string" },
        "username": { "type": "string" }
      }
    },

    "smaca_thresholds": {
      "type": "object",
      "required": ["cv_fail", "cv_warn", "low_cov_absolute", "low_cov_relative"],
      "properties": {
        "cv_fail": { "type": "number" },
        "cv_warn": { "type": "number" },
        "low_cov_absolute": { "type": "number" },
        "low_cov_relative": { "type": "number" }
      }
    }
  }
}