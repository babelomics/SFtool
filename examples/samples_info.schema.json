{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SFtool samples_info schema",
  "type": "object",

  "required": ["execution", "samples"],

  "properties": {
    "execution": {
      "type": "object",
      "required": ["modes", "reference_genome"],
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "secondary_findings_discovery",
              "variant_confirmation"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },

        "variant_classification_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "genebe",
              "clinvar"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "default": [
            "genebe",
            "clinvar"
          ]
        },

        "reference_genome": {
          "type": "string",
          "enum": ["GRCh37", "GRCh38"],
          "default": "GRCh37"
        },

        "clinvar_evidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        },

        "RR_mode": {
          "type": "string",
          "enum": ["screening", "advanced"],
          "default": "screening"
        }
      }
    },

    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,

      "items": {
        "type": "object",
        "required": ["sample_id", "relation", "vcf_path"],

        "properties": {
          "sample_id": { "type": "string" },

          "sex": {
            "type": "string",
            "description": "Biological sex of the sample",
            "enum": ["male", "female", "unknown"]
          },

          "relation": {
            "type": "string",
            "enum": ["proband", "parent1", "parent2"]
          },

          "pgx_vcf_path": { "type": "string" },
          "vcf_path": { "type": "string" },
          "hpo_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^HP:[0-9]{7}$"
            },
            "description": "List of HPO terms associated with the individual",
            "default": []
          },

          "stripy_path": {
            "type": "string",
            "default": ""
          },
          "smaca_path": {
            "type": "string",
            "default": ""
          },

          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["PR", "RR", "PGx"]
            }
          },

          "variant_confirmation": {
            "type": "object",
            "required": [
              "variant"
            ],
            "properties": {
              "variant": {
                "type": "string",
                "minLength": 1,
                "description": "Diagnostic variant represented as chr:pos:ref:alt, HGVSc, HGVSg or HGVSp"
              }
            }
          }


        }
      }
    }
  }
}
